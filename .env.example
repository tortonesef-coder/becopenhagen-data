# Copy to .env on the server and fill in. .env is gitignored, never commit it.

# Port. Caddy reverse-proxies data.becopenhagen.dk here.
# 3456 is bc-fleet, 4100 is bc-wiki, 3000 is the Life OS router.
PORT=4200

# Signs the session cookie. Generate with: openssl rand -hex 32
# The server refuses to start without it, on purpose. No insecure fallback.
SESSION_SECRET=

# Who may sign in. This tool holds every customer's name, email and phone, and
# Fede's 2026-08-10 decision allows identified rows in answers, so this is a
# privacy control rather than a convenience. Fleet team_members ids.
ALLOWED_MEMBERS=fede,soren

# The model. Swappable without a deploy, per spec section 5.
AGENT_MODEL=claude-opus-5

# Left empty, the server reads ANTHROPIC_API_KEY from /etc/environment, which is
# where the fleet app keeps it. Runtime queries are billed to the API; build-time
# work is not (see CLAUDE_CONTEXT, cost policy).
ANTHROPIC_API_KEY=

# The fleet database. Opened READ ONLY, only to verify logins. Never written to.
FLEET_DB_PATH=/var/www/becopenhagen-fleet/data/fleet.db

WAREHOUSE_PATH=/var/lib/bc-data/warehouse.duckdb
CATALOG_PATH=/var/lib/bc-data/catalog_store.duckdb
